      "height": {
        "$type": "dimension",
        "$value": "{size.control.sm}"
      },
      "padding-inline": {
        "$type": "dimension",
        "$value": "{space.inset.sm}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.control}"
      }
    },
    "tertiary": {
      "bg": {
        "$type": "color",
        "hover": {
          "$value": "{color.bg.neutral.hover}"
        },
        "pressed": {
          "$value": "{color.bg.neutral.pressed}"
        }
