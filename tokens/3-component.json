          "pressed": {
            "$value": "{color.bg.inverse.pressed}"
          },
          "disabled": {
            "$value": "{color.bg.inverse.disabled}"
          }
        },
        "success": {
          "default": {
            "$value": "{color.bg.success.bold.default}"
          },
          "hover": {
            "$value": "{color.bg.success.bold.hover}"
          },
          "pressed": {
            "$value": "{color.bg.success.bold.pressed}"
          },
          "disabled": {
            "$value": "{color.bg.success.bold.disabled}"
          }
        },
        "danger": {
          "default": {
            "$value": "{color.bg.danger.bold.default}"
          },
          "hover": {
            "$value": "{color.bg.danger.bold.hover}"
